<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Color x:Key="FuchsBackgroundColor">#F1F4F7</Color>
    <Color x:Key="FuchsFieldBackgroundColor">#E5EBF0</Color>
    <Color x:Key="FuchsTextColor">#141F23</Color>
    <Color x:Key="FuchsMutedTextColor">#516773</Color>
    <Color x:Key="FuchsFieldBorderColor">#9FB1BC</Color>
    <Color x:Key="FuchsFieldFocusColor">#167CC5</Color>
    <Color x:Key="FuchsFieldValidColor">#298C55</Color>
    <Color x:Key="FuchsFieldWarningColor">#D07800</Color>
    <Color x:Key="FuchsFieldInvalidColor">#C84646</Color>
    <Color x:Key="FuchsDefaultColor">#385661</Color>
    <Color x:Key="FuchsPrimaryColor">#167CC5</Color>
    <Color x:Key="FuchsSecondaryColor">#516773</Color>
    <Color x:Key="FuchsSuccessColor">#298C55</Color>
    <Color x:Key="FuchsInfoColor">#189DC6</Color>
    <Color x:Key="FuchsWarningColor">#D07800</Color>
    <Color x:Key="FuchsDangerColor">#C84646</Color>
    <Color x:Key="FuchsLightColor">#E5EBF0</Color>
    <Color x:Key="FuchsDarkColor">#263B43</Color>
    <Color x:Key="FuchsPrimaryLight">#D7EAF8</Color>
    <x:Double x:Key="FuchsBorderWidth">1</x:Double>
    <CornerRadius x:Key="FuchsCornerRadius">4</CornerRadius>

    <Style x:Key="FuchsFieldLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource FuchsTextColor}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="6,4,6,0" />
    </Style>
    <Style x:Key="FuchsFieldHelpTextStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource FuchsMutedTextColor}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="6,0,6,4" />
    </Style>
    <Style x:Key="FuchsEntryStyle" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource FuchsTextColor}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource FuchsMutedTextColor}" />
        <Setter Property="Margin" Value="10,0" />
        <Setter Property="HeightRequest" Value="42" />
    </Style>
    <Style x:Key="FuchsEditorStyle" TargetType="Editor">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource FuchsTextColor}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource FuchsMutedTextColor}" />
        <Setter Property="Margin" Value="10,0" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="AutoSize" Value="TextChanges" />
        <Setter Property="MinimumHeightRequest" Value="88" />
    </Style>
    <Style x:Key="FuchsPickerStyle" TargetType="Picker">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource FuchsTextColor}" />
        <Setter Property="Margin" Value="10,0" />
        <Setter Property="HeightRequest" Value="42" />
    </Style>
    <Style x:Key="FuchsDatePickerStyle" TargetType="DatePicker">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource FuchsTextColor}" />
        <Setter Property="Margin" Value="10,0" />
        <Setter Property="HeightRequest" Value="42" />
    </Style>
    <Style x:Key="FuchsTimePickerStyle" TargetType="TimePicker">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource FuchsTextColor}" />
        <Setter Property="Margin" Value="10,0" />
        <Setter Property="HeightRequest" Value="42" />
    </Style>
    <Style x:Key="FuchsSwitchStyle" TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource FuchsPrimaryColor}" />
        <Setter Property="ThumbColor" Value="White" />
    </Style>
    <Style x:Key="FuchsCheckboxStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource FuchsFieldBackgroundColor}" />
        <Setter Property="BorderColor" Value="{DynamicResource FuchsFieldBorderColor}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="TextColor" Value="{DynamicResource FuchsSuccessColor}" />
    </Style>
    <Style x:Key="FuchsRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="TextColor" Value="{DynamicResource FuchsPrimaryColor}" />
    </Style>
    <Style x:Key="FuchsRangeStyle" TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{DynamicResource FuchsPrimaryColor}" />
        <Setter Property="MaximumTrackColor" Value="{DynamicResource FuchsFieldBorderColor}" />
        <Setter Property="ThumbColor" Value="{DynamicResource FuchsFieldBackgroundColor}" />
        <Setter Property="Margin" Value="10,0" />
    </Style>
    <Style x:Key="FuchsTickerButtonStyle" TargetType="Button" BasedOn="{StaticResource FuchsCheckboxStyle}">
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="FuchsButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="14,10,14,8" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
</ResourceDictionary>