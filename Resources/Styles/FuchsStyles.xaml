<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:controls="clr-namespace:FuchsControls"
                    x:Class="FuchsControls.Resources.Styles.FuchsStyles">
    <!-- Flatify's default palette and geometry, translated to MAUI resources. -->
    <Color x:Key="FuchsBackgroundColor">#FFFFFF</Color>
    <Color x:Key="FuchsFieldBackgroundColor">#F1F4F7</Color>
    <Color x:Key="FuchsTextColor">#2E4051</Color>
    <Color x:Key="FuchsMutedTextColor">#77838E</Color>
    <Color x:Key="FuchsFieldBorderColor">#CED9E3</Color>
    <Color x:Key="FuchsFieldFocusColor">#1CB0F6</Color>
    <Color x:Key="FuchsFieldValidColor">#58CC02</Color>
    <Color x:Key="FuchsFieldWarningColor">#FF9600</Color>
    <Color x:Key="FuchsFieldInvalidColor">#FF4B4B</Color>
    <Color x:Key="FuchsDefaultColor">#F1F4F7</Color>
    <Color x:Key="FuchsPrimaryColor">#1CB0F6</Color>
    <Color x:Key="FuchsSecondaryColor">#77838E</Color>
    <Color x:Key="FuchsSuccessColor">#58CC02</Color>
    <Color x:Key="FuchsInfoColor">#1CB0F6</Color>
    <Color x:Key="FuchsWarningColor">#FF9600</Color>
    <Color x:Key="FuchsDangerColor">#FF4B4B</Color>
    <Color x:Key="FuchsLightColor">#FFFFFF</Color>
    <Color x:Key="FuchsDarkColor">#1E2A35</Color>
    <Color x:Key="FuchsPrimaryLight">#77D0FA</Color>
    <x:Double x:Key="FuchsBorderWidth">2</x:Double>
    <CornerRadius x:Key="FuchsCornerRadius">16</CornerRadius>
    <x:Int32 x:Key="FuchsButtonCornerRadius">16</x:Int32>
    <x:Double x:Key="FuchsFieldHeight">44</x:Double>
    <x:Double x:Key="FuchsMultilineFieldMinimumHeight">96</x:Double>

    <x:Double x:Key="FuchsDisabledOpacity">0.7</x:Double>
    <x:Double x:Key="FuchsHoverOpacity">0.95</x:Double>
    <x:Double x:Key="FuchsPressedOpacity">0.95</x:Double>
    <x:Double x:Key="FuchsPressedTranslation">2.76</x:Double>
    <x:Single x:Key="FuchsButtonShadowOpacity">0.85</x:Single>
    <x:Single x:Key="FuchsCardShadowOpacity">0.2</x:Single>

    <!-- Flatify typography tokens translated to MAUI values. -->
    <x:Double x:Key="FuchsBodyFontSize">16</x:Double>
    <x:Double x:Key="FuchsCaptionFontSize">12</x:Double>
    <x:Double x:Key="FuchsSubtitleFontSize">20</x:Double>
    <x:Double x:Key="FuchsH1FontSize">56</x:Double>
    <x:Double x:Key="FuchsH2FontSize">48</x:Double>
    <x:Double x:Key="FuchsH3FontSize">37.6</x:Double>
    <x:Double x:Key="FuchsH4FontSize">32</x:Double>
    <x:Double x:Key="FuchsH5FontSize">26.4</x:Double>
    <x:Double x:Key="FuchsH6FontSize">21.6</x:Double>
    <x:Double x:Key="FuchsBodyLineHeight">1.5</x:Double>

    <Style x:Key="FuchsTypoBodyStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource FuchsTextColor}" />
        <Setter Property="FontSize" Value="{DynamicResource FuchsBodyFontSize}" />
        <Setter Property="LineHeight" Value="{DynamicResource FuchsBodyLineHeight}" />
    </Style>
    <Style x:Key="FuchsTypoCaptionStyle" TargetType="Label" BasedOn="{StaticResource FuchsTypoBodyStyle}">
        <Setter Property="FontSize" Value="{DynamicResource FuchsCaptionFontSize}" />
    </Style>
    <Style x:Key="FuchsTypoSubtitleStyle" TargetType="Label" BasedOn="{StaticResource FuchsTypoBodyStyle}">
        <Setter Property="FontSize" Value="{DynamicResource FuchsSubtitleFontSize}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="FuchsTypoH1Style" TargetType="Label" BasedOn="{StaticResource FuchsTypoBodyStyle}">
        <Setter Property="FontSize" Value="{DynamicResource FuchsH1FontSize}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="FuchsTypoH2Style" TargetType="Label" BasedOn="{StaticResource FuchsTypoH1Style}">
        <Setter Property="FontSize" Value="{DynamicResource FuchsH2FontSize}" />
    </Style>
    <Style x:Key="FuchsTypoH3Style" TargetType="Label" BasedOn="{StaticResource FuchsTypoH1Style}">
        <Setter Property="FontSize" Value="{DynamicResource FuchsH3FontSize}" />
    </Style>
    <Style x:Key="FuchsTypoH4Style" TargetType="Label" BasedOn="{StaticResource FuchsTypoBodyStyle}">
        <Setter Property="FontSize" Value="{DynamicResource FuchsH4FontSize}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="FuchsTypoH5Style" TargetType="Label" BasedOn="{StaticResource FuchsTypoH4Style}">
        <Setter Property="FontSize" Value="{DynamicResource FuchsH5FontSize}" />
    </Style>
    <Style x:Key="FuchsTypoH6Style" TargetType="Label" BasedOn="{StaticResource FuchsTypoH4Style}">
        <Setter Property="FontSize" Value="{DynamicResource FuchsH6FontSize}" />
    </Style>

    <Style x:Key="FuchsSpanBodyStyle" TargetType="Span">
        <Setter Property="TextColor" Value="{DynamicResource FuchsTextColor}" />
        <Setter Property="FontSize" Value="{DynamicResource FuchsBodyFontSize}" />
    </Style>
    <Style x:Key="FuchsSpanCaptionStyle" TargetType="Span" BasedOn="{StaticResource FuchsSpanBodyStyle}">
        <Setter Property="FontSize" Value="{DynamicResource FuchsCaptionFontSize}" />
    </Style>
    <Style x:Key="FuchsSpanSubtitleStyle" TargetType="Span" BasedOn="{StaticResource FuchsSpanBodyStyle}">
        <Setter Property="FontSize" Value="{DynamicResource FuchsSubtitleFontSize}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="FuchsSpanH1Style" TargetType="Span" BasedOn="{StaticResource FuchsSpanBodyStyle}">
        <Setter Property="FontSize" Value="{DynamicResource FuchsH1FontSize}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="FuchsSpanH2Style" TargetType="Span" BasedOn="{StaticResource FuchsSpanH1Style}">
        <Setter Property="FontSize" Value="{DynamicResource FuchsH2FontSize}" />
    </Style>
    <Style x:Key="FuchsSpanH3Style" TargetType="Span" BasedOn="{StaticResource FuchsSpanH1Style}">
        <Setter Property="FontSize" Value="{DynamicResource FuchsH3FontSize}" />
    </Style>
    <Style x:Key="FuchsSpanH4Style" TargetType="Span" BasedOn="{StaticResource FuchsSpanBodyStyle}">
        <Setter Property="FontSize" Value="{DynamicResource FuchsH4FontSize}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>
    <Style x:Key="FuchsSpanH5Style" TargetType="Span" BasedOn="{StaticResource FuchsSpanH4Style}">
        <Setter Property="FontSize" Value="{DynamicResource FuchsH5FontSize}" />
    </Style>
    <Style x:Key="FuchsSpanH6Style" TargetType="Span" BasedOn="{StaticResource FuchsSpanH4Style}">
        <Setter Property="FontSize" Value="{DynamicResource FuchsH6FontSize}" />
    </Style>

    <!-- Flatify-inspired tab resources. The controls apply these by DynamicResource so theme changes flow through. -->
    <RoundRectangle x:Key="FuchsTabsShape" CornerRadius="{DynamicResource FuchsCornerRadius}" />
    <RoundRectangle x:Key="FuchsTabShape" CornerRadius="{DynamicResource FuchsCornerRadius}" />
    <Style x:Key="FuchsTabsStyle" TargetType="ContentView">
        <Setter Property="Margin" Value="0,8" />
    </Style>
    <Style x:Key="FuchsTabsBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource FuchsBackgroundColor}" />
        <Setter Property="Stroke" Value="{DynamicResource FuchsFieldBorderColor}" />
        <Setter Property="StrokeThickness" Value="{DynamicResource FuchsBorderWidth}" />
        <Setter Property="StrokeShape" Value="{StaticResource FuchsTabsShape}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Offset="0,2" Radius="0" Opacity="0.15" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="FuchsTabsPlainStyle" TargetType="Border" BasedOn="{StaticResource FuchsTabsBorderStyle}">
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
    </Style>
    <Style x:Key="FuchsTabsHeaderScrollStyle" TargetType="ScrollView">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Never" />
        <Setter Property="VerticalScrollBarVisibility" Value="Never" />
    </Style>
    <Style x:Key="FuchsTabsHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource FuchsFieldBackgroundColor}" />
        <Setter Property="Padding" Value="12,4" />
    </Style>
    <Style x:Key="FuchsTabsHeaderItemsStyle" TargetType="FlexLayout">
        <Setter Property="Direction" Value="Row" />
        <Setter Property="AlignItems" Value="Center" />
        <Setter Property="Wrap" Value="Wrap" />
    </Style>
    <Style x:Key="FuchsTabsHeaderDividerStyle" TargetType="BoxView">
        <Setter Property="Color" Value="{DynamicResource FuchsFieldBorderColor}" />
        <Setter Property="HeightRequest" Value="{DynamicResource FuchsBorderWidth}" />
    </Style>
    <Style x:Key="FuchsTabHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource FuchsFieldBackgroundColor}" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="{StaticResource FuchsTabShape}" />
        <Setter Property="Padding" Value="14,10,14,8" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="{DynamicResource FuchsDisabledOpacity}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="FuchsTabDisabledHeaderStyle" TargetType="Border" BasedOn="{StaticResource FuchsTabHeaderStyle}">
        <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style x:Key="FuchsTabTextStyle" TargetType="Label" BasedOn="{StaticResource FuchsTypoBodyStyle}">
        <Setter Property="Opacity" Value="0.75" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource FuchsPrimaryColor}" />
                            <Setter Property="FontAttributes" Value="Bold" />
                            <Setter Property="Opacity" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="{DynamicResource FuchsDisabledOpacity}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="FuchsTabActiveTextStyle" TargetType="Label" BasedOn="{StaticResource FuchsTabTextStyle}">
        <Setter Property="TextColor" Value="{DynamicResource FuchsPrimaryColor}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style x:Key="FuchsTabIndicatorStyle" TargetType="BoxView">
        <Setter Property="Color" Value="{DynamicResource FuchsFieldBorderColor}" />
        <Setter Property="HeightRequest" Value="{DynamicResource FuchsBorderWidth}" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="TabIndicatorStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Property="Color" Value="{DynamicResource FuchsPrimaryColor}" />
                            <Setter Property="Opacity" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="FuchsTabActiveIndicatorStyle" TargetType="BoxView" BasedOn="{StaticResource FuchsTabIndicatorStyle}">
        <Setter Property="Color" Value="{DynamicResource FuchsPrimaryColor}" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style x:Key="FuchsTabDisabledIndicatorStyle" TargetType="BoxView"
           BasedOn="{StaticResource FuchsTabIndicatorStyle}">
    </Style>
    <Style x:Key="FuchsTabsContentStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource FuchsBackgroundColor}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="FuchsTabPanelsStyle" TargetType="Grid">
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="FuchsTabPanelStyle" TargetType="ContentView">
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <Style x:Key="FuchsAccordionStyle" TargetType="controls:FuchsAccordion">
        <Setter Property="Margin" Value="0,8" />
        <Setter Property="BackgroundColor" Value="{DynamicResource FuchsBackgroundColor}" />
    </Style>
    <Style x:Key="FuchsAccordionItemsStyle" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="8" />
    </Style>
    <Style x:Key="FuchsAccordionItemStyle" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="0" />
    </Style>
    <Style x:Key="FuchsAccordionHeaderGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>
    <Style x:Key="FuchsAccordionHeaderStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,14,16,12" />
        <Setter Property="StrokeThickness" Value="{DynamicResource FuchsBorderWidth}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="{DynamicResource FuchsCornerRadius}" />
            </Setter.Value>
        </Setter>
        <Setter Property="Background" Value="{DynamicResource FuchsBackgroundColor}" />
        <Setter Property="Stroke" Value="{DynamicResource FuchsFieldBorderColor}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Offset="0,2" Radius="0" Opacity="0.15" />
            </Setter.Value>
        </Setter>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="AccordionHeaderStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Expanded">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="{DynamicResource FuchsFieldBackgroundColor}" />
                            <Setter Property="Stroke" Value="{DynamicResource FuchsPrimaryColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="{DynamicResource FuchsDisabledOpacity}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="ExpandedDisabled">
                        <VisualState.Setters>
                            <Setter Property="Background" Value="{DynamicResource FuchsFieldBackgroundColor}" />
                            <Setter Property="Stroke" Value="{DynamicResource FuchsPrimaryColor}" />
                            <Setter Property="Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="FuchsAccordionHeaderTextStyle" TargetType="controls:FuchsTypo"
           BasedOn="{StaticResource FuchsTypoBodyStyle}">
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>
    <Style x:Key="FuchsAccordionIndicatorStyle" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource FuchsBodyFontSize}" />
        <Setter Property="TextColor" Value="{DynamicResource FuchsTextColor}" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="AccordionIndicatorStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Expanded">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource FuchsPrimaryColor}" />
                            <Setter Property="Rotation" Value="180" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style x:Key="FuchsAccordionPanelStyle" TargetType="ContentView">
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="BackgroundColor" Value="{DynamicResource FuchsBackgroundColor}" />
    </Style>
    <RoundRectangle x:Key="FuchsCardShape" CornerRadius="{DynamicResource FuchsCornerRadius}" />
    <Style x:Key="FuchsCardStyle" TargetType="controls:FuchsCard">
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Background" Value="{DynamicResource FuchsBackgroundColor}" />
        <Setter Property="Stroke" Value="{DynamicResource FuchsFieldBorderColor}" />
        <Setter Property="StrokeThickness" Value="{DynamicResource FuchsBorderWidth}" />
        <Setter Property="StrokeShape" Value="{StaticResource FuchsCardShape}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Offset="0,2" Radius="0" Opacity="{DynamicResource FuchsCardShadowOpacity}" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FuchsActionCardLayoutStyle" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="10" />
    </Style>
    <Style x:Key="FuchsActionCardBadgesStyle" TargetType="FlexLayout">
        <Setter Property="Direction" Value="Row" />
        <Setter Property="Wrap" Value="Wrap" />
        <Setter Property="AlignItems" Value="Center" />
    </Style>
    <Style x:Key="FuchsActionCardImageStyle" TargetType="controls:FuchsImage">
        <Setter Property="HeightRequest" Value="180" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>
    <Style x:Key="FuchsCardIconStyle" TargetType="controls:FuchsIcon">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>
    <Style x:Key="FuchsActionCardFooterStyle" TargetType="HorizontalStackLayout">
        <Setter Property="Spacing" Value="8" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style x:Key="FuchsItemCardLayoutStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="16" />
        <Setter Property="RowSpacing" Value="12" />
        <Setter Property="VerticalOptions" Value="Start" />
    </Style>
    <Style x:Key="FuchsItemCardImageAreaStyle" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="8" />
        <Setter Property="VerticalOptions" Value="Start" />
    </Style>
    <Style x:Key="FuchsItemCardContentStyle" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="8" />
        <Setter Property="VerticalOptions" Value="Start" />
    </Style>
    <Style x:Key="FuchsContainerStyle" TargetType="controls:FuchsContainer">
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>
    <Style x:Key="FuchsIconStyle" TargetType="controls:FuchsIcon">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="InputTransparent" Value="True" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="FuchsIconPathStyle" TargetType="Path">
        <Setter Property="Aspect" Value="Uniform" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="StrokeThickness" Value="0" />
    </Style>

    <Style x:Key="FuchsFieldLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource FuchsTextColor}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="{DynamicResource FuchsCaptionFontSize}" />
        <Setter Property="Margin" Value="6,4,6,0" />
    </Style>
    <Style x:Key="FuchsFieldHelpTextStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource FuchsMutedTextColor}" />
        <Setter Property="FontSize" Value="{DynamicResource FuchsCaptionFontSize}" />
        <Setter Property="Margin" Value="6,0,6,4" />
    </Style>
    <Style x:Key="FuchsFormStyle" TargetType="controls:FuchsForm" BasedOn="{StaticResource FuchsCardStyle}">
        <Setter Property="Spacing" Value="12" />
    </Style>
    <Style x:Key="FuchsFieldContentStyle" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="4" />
    </Style>
    <Style x:Key="FuchsFieldBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="2" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="{DynamicResource FuchsCornerRadius}" />
            </Setter.Value>
        </Setter>
        <Setter Property="StrokeThickness" Value="{DynamicResource FuchsBorderWidth}" />
        <Setter Property="Stroke" Value="{DynamicResource FuchsFieldBorderColor}" />
        <Setter Property="Background" Value="{DynamicResource FuchsFieldBackgroundColor}" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Offset="0,2" Radius="0" Opacity="0.12" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FuchsAutocompleteSuggestionsStyle" TargetType="Border"
           BasedOn="{StaticResource FuchsFieldBorderStyle}" />
    <Style x:Key="FuchsAutocompleteSuggestionStyle" TargetType="Label"
           BasedOn="{StaticResource FuchsTypoBodyStyle}">
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>
    <Style x:Key="FuchsFormOptionLayoutStyle" TargetType="HorizontalStackLayout">
        <Setter Property="Spacing" Value="8" />
    </Style>
    <Style x:Key="FuchsFormOptionTextStyle" TargetType="controls:FuchsTypo"
           BasedOn="{StaticResource FuchsTypoBodyStyle}">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>
    <Style x:Key="FuchsColorPreviewStyle" TargetType="BoxView">
        <Setter Property="WidthRequest" Value="28" />
        <Setter Property="HeightRequest" Value="28" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>
    <Style x:Key="FuchsFormOptionLayoutVerticalStyle" TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="4" />
    </Style>
    <Style x:Key="FuchsTickerGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="0" />
    </Style>
    <Style x:Key="FuchsEntryStyle" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource FuchsTextColor}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource FuchsMutedTextColor}" />
        <Setter Property="FontSize" Value="{DynamicResource FuchsBodyFontSize}" />
        <Setter Property="Margin" Value="10,0,10,1" />
        <Setter Property="HeightRequest" Value="{DynamicResource FuchsFieldHeight}" />
    </Style>
    <Style x:Key="FuchsEditorStyle" TargetType="Editor">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource FuchsTextColor}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource FuchsMutedTextColor}" />
        <Setter Property="FontSize" Value="{DynamicResource FuchsBodyFontSize}" />
        <Setter Property="Margin" Value="10,0,10,1" />
        <Setter Property="HeightRequest" Value="{DynamicResource FuchsFieldHeight}" />
        <Setter Property="AutoSize" Value="TextChanges" />
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource FuchsMultilineFieldMinimumHeight}" />
    </Style>
    <Style x:Key="FuchsPickerStyle" TargetType="Picker">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource FuchsTextColor}" />
        <Setter Property="FontSize" Value="{DynamicResource FuchsBodyFontSize}" />
        <Setter Property="Margin" Value="10,0,10,1" />
        <Setter Property="HeightRequest" Value="{DynamicResource FuchsFieldHeight}" />
    </Style>
    <Style x:Key="FuchsDatePickerStyle" TargetType="DatePicker">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource FuchsTextColor}" />
        <Setter Property="FontSize" Value="{DynamicResource FuchsBodyFontSize}" />
        <Setter Property="Margin" Value="10,0,10,1" />
        <Setter Property="HeightRequest" Value="{DynamicResource FuchsFieldHeight}" />
    </Style>
    <Style x:Key="FuchsTimePickerStyle" TargetType="TimePicker">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource FuchsTextColor}" />
        <Setter Property="FontSize" Value="{DynamicResource FuchsBodyFontSize}" />
        <Setter Property="Margin" Value="10,0,10,1" />
        <Setter Property="HeightRequest" Value="{DynamicResource FuchsFieldHeight}" />
    </Style>
    <Style x:Key="FuchsSwitchStyle" TargetType="controls:FuchsSwitch">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="{DynamicResource FuchsHoverOpacity}" />
                        </VisualState.Setters>
                    </VisualState>
